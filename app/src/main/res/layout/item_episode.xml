<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="top"
    android:background="?attr/selectableItemBackground">

    <!-- Miniatura del episodio -->
    <FrameLayout
        android:layout_width="110dp"
        android:layout_height="65dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/iv_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/bg3"/>

        <TextView
            android:id="@+id/tv_thumb_ph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▶"
            android:textSize="24sp"
            android:textColor="@color/muted"
            android:visibility="gone"/>

        <!-- Barra de progreso del episodio -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33FFFFFF"/>

            <View
                android:id="@+id/episode_progress_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/accent"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- Badge "visto" cuando progreso > 90% -->
        <TextView
            android:id="@+id/tv_watched"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="3dp"
            android:text="✓"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@color/accent"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Info del episodio -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tv_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/muted2"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <!-- Texto de progreso -->
        <TextView
            android:id="@+id/tv_progress_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/accent"
            android:layout_marginTop="4dp"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
