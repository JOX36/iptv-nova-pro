<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    android:fitsSystemWindows="false">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000"
        android:padding="0dp"/>

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="X"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_resolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00D4FF"
                android:textSize="10sp"
                android:visibility="gone"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#EF4444"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingEnd="8dp"/>

        <TextView
            android:id="@+id/btn_fav"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="☆"
            android:textSize="22sp"
            android:textColor="#FFD700"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>

    <!-- Bottom bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- SeekBar — solo VOD/Series -->
        <LinearLayout
            android:id="@+id/layout_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:text="0:00"
                android:layout_marginEnd="8dp"/>

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="#00D4FF"
                android:thumbTint="#00D4FF"/>

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:text="0:00"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- Botones Live -->
        <LinearLayout
            android:id="@+id/layout_live_btns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_prev"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="⏮"
                android:textSize="18sp"
                android:backgroundTint="#1a2535"
                android:textColor="#00D4FF"
                android:layout_marginEnd="8dp"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btn_next"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="⏭"
                android:textSize="18sp"
                android:backgroundTint="#1a2535"
                android:textColor="#00D4FF"
                android:layout_marginEnd="8dp"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btn_pip_live"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="⧉"
                android:textSize="16sp"
                android:backgroundTint="#1a2535"
                android:textColor="#7AB8CC"
                android:layout_marginEnd="8dp"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="■"
                android:textSize="16sp"
                android:backgroundTint="#55EF4444"
                android:textColor="#EF4444"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btn_epg"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="EPG"
                android:textSize="10sp"
                android:backgroundTint="#1a2535"
                android:textColor="#00D4FF"
                android:layout_marginStart="8dp"
                android:padding="0dp"/>

        </LinearLayout>

        <!-- Botones VOD/Series -->
        <LinearLayout
            android:id="@+id/layout_vod_btns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <!-- Play/Pause -->
            <Button
                android:id="@+id/btn_play_pause"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="⏸"
                android:textSize="18sp"
                android:backgroundTint="#1a2535"
                android:textColor="#00D4FF"
                android:layout_marginEnd="8dp"
                android:padding="0dp"/>

            <!-- -10s -->
            <Button
                android:id="@+id/btn_rewind"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="-10"
                android:textSize="12sp"
                android:backgroundTint="#1a2535"
                android:textColor="#00D4FF"
                android:layout_marginEnd="8dp"
                android:padding="0dp"/>

            <!-- +10s -->
            <Button
                android:id="@+id/btn_forward"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="+10"
                android:textSize="12sp"
                android:backgroundTint="#1a2535"
                android:textColor="#00D4FF"
                android:layout_marginEnd="8dp"
                android:padding="0dp"/>

            <!-- Audio -->
            <Button
                android:id="@+id/btn_audio"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="♪"
                android:textSize="18sp"
                android:backgroundTint="#1a2535"
                android:textColor="#7AB8CC"
                android:layout_marginEnd="8dp"
                android:padding="0dp"/>

            <!-- Subtítulos -->
            <Button
                android:id="@+id/btn_subs"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="CC"
                android:textSize="12sp"
                android:backgroundTint="#1a2535"
                android:textColor="#7AB8CC"
                android:layout_marginEnd="8dp"
                android:padding="0dp"/>

            <!-- PiP -->
            <Button
                android:id="@+id/btn_pip"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="⧉"
                android:textSize="16sp"
                android:backgroundTint="#1a2535"
                android:textColor="#7AB8CC"
                android:layout_marginEnd="8dp"
                android:padding="0dp"/>

            <!-- Detener -->
            <Button
                android:id="@+id/btn_stop_vod"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="■"
                android:textSize="16sp"
                android:backgroundTint="#55EF4444"
                android:textColor="#EF4444"
                android:padding="0dp"/>

        </LinearLayout>

    </LinearLayout>


    <!-- Panel EPG — overlay -->
    <LinearLayout
        android:id="@+id/epg_panel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#EE0a0e14"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GUÍA DE PROGRAMACIÓN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#00D4FF"
            android:letterSpacing="0.1"
            android:padding="14dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#22FFFFFF"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_epg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"/>

    </LinearLayout>

</FrameLayout>
